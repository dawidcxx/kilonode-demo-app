{
  "name": "kilonode-demo-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:common && bun run dev:backend & bun run dev:web & bun run dev:common",
    "typecheck": "bun --filter '*' typecheck",
    "dev:backend": "bun --filter @kilonode-demo-app/backend dev",
    "dev:web": "bun --filter @kilonode-demo-app/web dev",
    "dev:common": "bun --filter @kilonode-demo-app/common dev",
    "build:backend": "bun --filter @kilonode-demo-app/backend build",
    "build:web": "bun --filter @kilonode-demo-app/web build",
    "build:common": "bun --filter @kilonode-demo-app/common build",
    "test": "bun --filter '*' test"
  }
}
